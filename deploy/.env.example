# Skopiuj do .env i uzupelnij przed pierwszym uruchomieniem.

# Haslo bazy - wygeneruj losowe, np.: openssl rand -base64 32
POSTGRES_PASSWORD=zmien-mnie
POSTGRES_DB=cmdb
POSTGRES_USER=cmdb

# Klucz podpisujacy sesje panelu. Minimum 32 znaki.
# Wygeneruj: docker compose run --rm server python -m cmdb_server.cli gen-secret
CMDB_SECRET_KEY=zmien-mnie-na-losowy-ciag-co-najmniej-32-znaki

# Po ilu godzinach bez kontaktu maszyna jest oznaczana jako nieaktywna.
CMDB_STALE_AFTER_HOURS=48

# Ile snapshotow trzymamy na maszyne (0 = bez limitu).
CMDB_SNAPSHOT_RETENTION=50

# Co ile sekund agenci maja raportowac.
CMDB_REPORT_INTERVAL_SECONDS=3600

CMDB_LOG_LEVEL=INFO
