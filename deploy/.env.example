# Skopiuj do .env i uzupelnij przed pierwszym uruchomieniem.

# Haslo bazy - wygeneruj losowe, np.: openssl rand -base64 32
POSTGRES_PASSWORD=zmien-mnie
POSTGRES_DB=cmdb
POSTGRES_USER=cmdb

# Klucz podpisujacy sesje panelu. Minimum 32 znaki.
# Wygeneruj: docker compose run --rm server python -m cmdb_server.cli gen-secret
CMDB_SECRET_KEY=zmien-mnie-na-losowy-ciag-co-najmniej-32-znaki

# Adres, pod ktorym klienci widza serwer. WYMAGANY - trafia do wydawanego
# skryptu instalacyjnego agenta, a za posrednikiem nie da sie go wiarygodnie
# odgadnac z zadania (widac tam adres kontenera).
CMDB_PUBLIC_URL=https://cmdb.twoja-firma.pl

# Klucz do NVD - podnosi limit pobierania ocen CVSS z 5 do 50 zapytan na
# 30 sekund. Bezplatny: https://nvd.nist.gov/developers/request-an-api-key
# Bez niego wszystko dziala, tylko wolniej.
CMDB_NVD_API_KEY=

# Blokada logowania do panelu: po ilu nieudanych probach i na ile godzin.
# Obejmuje konto ORAZ adres, z ktorego przychodzily proby.
# Zdjecie blokady: docker compose exec server python -m cmdb_server.cli odblokuj --email ...
CMDB_LOGIN_MAX_FAILURES=3
CMDB_LOGIN_LOCKOUT_HOURS=24

# Po ilu godzinach bez kontaktu maszyna jest oznaczana jako nieaktywna.
CMDB_STALE_AFTER_HOURS=48

# Ile snapshotow trzymamy na maszyne (0 = bez limitu).
CMDB_SNAPSHOT_RETENTION=50

# Co ile sekund agenci maja raportowac.
CMDB_REPORT_INTERVAL_SECONDS=3600

CMDB_LOG_LEVEL=INFO

# Zaufane, przetestowane binaria Windows. Brak wpisow = brak dystrybucji.
# Kopiuj SHA-256 z ZAUFANEGO przebiegu CI, nie z przeslanego przez uzytkownika pliku.
# Format: {"<sha256>":{"version":"0.5.10","arch":"x86_64"}}
# Szczegoly: docs/zaufane-wydania-windows.md
CMDB_TRUSTED_WINDOWS_BUILDS='{}'

# Automatyczny import podpisanych wydań. Konfiguracja jednorazowa:
# docs/automatyczne-wydania.md. Klucz PRYWATNY trafia tylko do GitHub Actions.
CMDB_RELEASE_IMPORT_ENABLED=false
CMDB_RELEASE_REPOSITORY=jaqb76/CMDB
CMDB_RELEASE_REF=refs/heads/claude/os-data-collection-agent-gfz2o8
CMDB_RELEASE_PUBLIC_KEYS='{}'
# Fine-grained PAT: wyłącznie to prywatne repo, Contents: read.
CMDB_RELEASE_GITHUB_TOKEN=
CMDB_RELEASE_IMPORT_INTERVAL=300

# --- kopie zapasowe ---
# Ile archiwow trzymamy. Dzienne rotuja sie codziennie, tygodniowe to kopie
# z niedzieli. Nocne zadanie zaklada je o 3:00 - wpis crona jest w
# docs/kopie-zapasowe.md.
CMDB_KOPIE_DZIENNYCH=7
CMDB_KOPIE_TYGODNIOWYCH=4

# --- oznaczenie instancji ---
# Puste znaczy produkcje: zaden pasek, zaden prefiks w tytule. Na instancji
# testowej wpisz cokolwiek, np. DEVELOPMENT - napis pojawi sie w pasku u gory
# i w tytule karty przegladarki. Przy CMDB_ENV=dev oznaczenie wlacza sie samo,
# nawet gdy to pole zostanie puste.
CMDB_INSTANCJA=
# bursztyn (domyslnie) | czerwony | fiolet | zielony
CMDB_INSTANCJA_BARWA=bursztyn

# Zaufany nginx. Adres jest staly, bo serwer ufa naglowkom X-Forwarded-*
# wylacznie z niego - CMDB_PROXY_IP musi lezec w CMDB_PROXY_SUBNET, wiec obie
# wartosci zmienia sie razem.
#
# Zmiany wymaga kolizja z siecia firmowa, a takze blad "Pool overlaps with
# other one on this address space" przy zakladaniu sieci cmdb-ingress: to
# znaczy, ze zakres zajela inna siec docker. Rozpoznanie i co dalej -
# docs/wdrozenie.md, "Siec cmdb-ingress nie powstaje".
CMDB_PROXY_SUBNET=172.30.77.0/24
CMDB_PROXY_IP=172.30.77.10
